# ============================================================
# WeKnora POC 环境配置模板
# 用法：cp poc.env.example .env.poc 后填写实际值
# 所有配置只改本文件，docker-compose.poc.yml 不漂移
# ============================================================

# ---------- 端口 ----------
# 默认 8080；若与本地开发实例（原生运行的 WeKnora 占 8080）冲突，
# 改为其他端口如 18080。frontend 默认 80。
APP_PORT=18080
FRONTEND_PORT=18081

# ---------- 构建参数（仅 build 阶段生效）----------
# Go 模块代理：默认 proxy.golang.org 在内网/受限网络不可达，构建用国内代理
GOPROXY_ARG=https://goproxy.cn,direct

# ---------- 数据库（compose 内 postgres 服务）----------
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=weknora
DB_PASSWORD=<change-me>
DB_NAME=weknora

# ---------- Redis（compose 内 redis 服务）----------
REDIS_ADDR=redis:6379
REDIS_PORT=6379
REDIS_PASSWORD=<change-me>
REDIS_DB=0
REDIS_PREFIX=weknora

# ---------- 文档解析（compose 内 docreader 服务）----------
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc
STREAM_MANAGER_TYPE=redis

# ---------- 对象存储 ----------
# POC 用 TencentCOS：填写真实凭据；或改用本地存储 STORAGE_TYPE=local
STORAGE_TYPE=local
COS_SECRET_ID=<change-me>
COS_SECRET_KEY=<change-me>
COS_REGION=
COS_BUCKET_NAME=
COS_APP_ID=
COS_PATH_PREFIX=
COS_TEMP_BUCKET_NAME=
COS_TEMP_REGION=

# ---------- 检索 ----------
RETRIEVE_DRIVER=postgres

# ---------- 安全（必填，生产强度随机值）----------
JWT_SECRET=<change-me>
SYSTEM_AES_KEY=<change-me>
# SSRF 白名单：内网模型地址（Thor 网关）必须加入，否则模型请求被拦截
SSRF_WHITELIST=localhost,127.0.0.1,ai-thor-qa.innostic.com

# ---------- 模型 ----------
# 模型在 Web 界面/DB 中配置，base_url 指向内网 Thor 网关：
#   http://<thor-内网IP>:<port>/v1/
# 可用模型：jf-deepseek-v4、qwen3.7-max（走 Thor 渠道）

# ---------- 运行时 ----------
TZ=Asia/Shanghai
GIN_MODE=release
LOG_LEVEL=debug
AUTO_MIGRATE=true
DISABLE_REGISTRATION=false
MAX_FILE_SIZE_MB=50

# ---------- 模型（Thor 网关，供 builtin_models.yaml 读取）----------
LLM_BASE_URL=https://ai-thor-qa.innostic.com/v1
LLM_API_KEY=<change-me>
LLM_MODEL_NAME=qwen3.7-max
EMBEDDING_BASE_URL=https://ai-thor-qa.innostic.com/v1
EMBEDDING_API_KEY=<change-me>
EMBEDDING_MODEL_NAME=text-embedding-v4

# ---------- PostgreSQL 对外端口 ----------
# 默认 5432，与宿主机已有实例冲突时改端口（如 5433）
POSTGRES_EXPOSE_PORT=5432

# ---------- 关键词检索降级开关 ----------
# 仅当宿主机 CPU 不支持 AVX2（pg_search.so 一加载即 SIGILL）时置 1：
# 关键词检索（bm25）退化为返回空结果，混合检索降级为纯向量检索，
# 而不是整个检索请求报错。正常环境保持 0/不设置，维持 fail-fast。
KEYWORD_RETRIEVAL_DEGRADED=0
